}

@article{bouchaudTrades,
  author  = {Jean-Philippe Bouchaud and J. Doyne Farmer and Fabrizio Lillo},
  title   = {How Markets Slowly Digest Changes in Supply and Demand},
  journal = {Handbook of Financial Markets: Dynamics and Evolution},
  year    = {2009},
  pages   = {57--160},
  annote = {Bouchaud, Farmer, and Lillo analyze how markets respond gradually to changes in supply and demand, highlighting the persistence of order flow and market impact. The chapter explains why price adjustments are not instantaneous and how trades influence subsequent price dynamics.

This work is important for my project because it shows that prediction and execution cannot be separated from market impact. Even accurate predictions may degrade due to delayed execution or adverse price movement. The authors are prominent researchers in quantitative finance, and the work appears in a respected handbook. It strengthens the theoretical motivation for modeling realistic execution constraints and measuring slippage and fill quality within my simulation environment.}

}

